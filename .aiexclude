# Files AI agents should generally not modify directly
# (These are generated, binary, or third-party)

# Binary assets
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.ttf
*.otf
*.woff
*.woff2

# Generated/build
*.pyc
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
node_modules/

# Project archives (example templates)
layout-templates/*.zip
boxart-templates/*.zip

# Environment/secrets
.env
.env.*
*.pem
*.key

# IDE/editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Dependencies (don't modify, just update requirements.txt)
# requirements.txt can be modified to add/update packages
